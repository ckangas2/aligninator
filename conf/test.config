/*
 * Minutes-scale end-to-end run on synthetic data shipped in tests/data/.
 *
 *   nextflow run ckangas2/aligninator -profile test,docker
 *
 * Two Drop-seq libraries against a ~250 kb host + 25 kb virus reference:
 * a mock library with no viral reads and an infected one where ~70% of
 * cells carry viral transcripts. The viral GTF is deliberately shipped in
 * its "as deposited" broken form (wrong contig name, no gene_name, names
 * that collide with host symbols) so the normalisation path runs for real.
 * tests/check_test_results.py asserts the outcome.
 */
params {
    input               = "${projectDir}/tests/data/samplesheet.csv"
    host_fasta          = "${projectDir}/tests/data/host.fa.gz"
    host_gtf            = "${projectDir}/tests/data/host.gtf.gz"
    viral_fasta         = "${projectDir}/tests/data/virus.fa.gz"
    viral_gtf           = "${projectDir}/tests/data/virus.gtf.gz"
    viral_contig_rename = 'HSV1:chrHSV1'
    sjdb_overhang       = 62

    cb_len              = 12
    umi_len             = 8
    whitelist           = 'None'
    // EmptyDrops needs thousands of barcodes to model ambient RNA; the test
    // library has a few hundred, so use the simple knee filter here.
    solo_cell_filter    = 'CellRanger2.2 150 0.99 10'
    barcode_top_k       = 100       // 100 cells planted

    max_cpus            = 2
    max_memory          = '6.GB'
    max_time            = '1.h'
}

process {
    withLabel: process_star_index { cpus = 2; memory = 4.GB }
    withLabel: process_star_align { cpus = 2; memory = 4.GB }
    withLabel: process_low        { cpus = 1; memory = 2.GB }
}
