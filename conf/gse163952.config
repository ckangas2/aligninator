/*
 * GSE163952 (Rybak-Wolf et al., Nat Microbiol 2023): HSV-1 infected brain
 * organoids. The dataset the pipeline was validated on (see RESULTS.md).
 *
 *   bash scripts/fetch_reference.sh
 *   bash scripts/fetch_runs.sh --sample exp2_iPSC-2_ctrl_rep1 exp2_iPSC-2_3dpi_rep1
 *   bash scripts/make_samplesheet.sh exp2_iPSC-2_ctrl_rep1 exp2_iPSC-2_3dpi_rep1 > samplesheet.csv
 *   nextflow run ckangas2/aligninator -profile gse163952,docker --input samplesheet.csv
 *
 * Paths are relative to the directory you launch from, which is where the
 * fetch scripts put things when run from a clone of this repository.
 */
params {
    host_fasta          = "${launchDir}/reference/GRCh38/fasta/genome.fa"
    host_gtf            = "${launchDir}/reference/GRCh38/genes/genes.gtf"
    viral_fasta         = "${launchDir}/reference/hsv1/GSE163952_HSV1GFPtrunc_corr.fa"
    viral_gtf           = "${launchDir}/reference/hsv1/GSE163952_HSV1GFPtrunc_corr.gtf"
    viral_prefix        = 'HSV1-'
    sjdb_overhang       = 62        // R2 is pre-trimmed, 53-63 bp, mode 63

    // Drop-seq, NOT 10x: R1 = 20 bp = 12 bp CB + 8 bp UMI, no whitelist.
    // Evidence in docs/CORRECTIONS.md.
    cb_len              = 12
    umi_len             = 8
    whitelist           = 'None'
    solo_strand         = 'Forward'
    solo_cell_filter    = 'EmptyDrops_CR'

    max_cpus            = 32
    max_memory          = 120.GB
}
