manifest {
    name            = 'ckangas2/aligninator'
    author          = 'Chase Kangas'
    homePage        = 'https://github.com/ckangas2/aligninator'
    description     = 'Host + virus single-cell alignment with STARsolo, with a validation layer for the failures that do not raise errors'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.2.0'
}

params {
    // input
    input               = null

    // reference: build from scratch ...
    host_fasta          = null
    host_gtf            = null
    viral_fasta         = null
    viral_gtf           = null
    viral_contig_rename = ''        // OLD:NEW, only if the GTF contig differs from the FASTA header
    viral_prefix        = 'HSV1-'   // prevents LAT / RS1 colliding with host symbols
    sjdb_overhang       = 100       // cDNA read length - 1; CHECK_READS reports the ideal value
    // ... or reuse one
    star_index          = null
    viral_genes         = null

    // chemistry: explicit, never guessed
    cb_len              = null
    umi_len             = null
    whitelist           = null      // path, or None for Drop-seq / Seq-Well
    solo_strand         = 'Forward'
    solo_cell_filter    = 'EmptyDrops_CR'
    solo_features       = 'Gene GeneFull'
    barcode_top_k       = 1000      // detection only: set near the expected number of cells
    exclude_from_viral  = 'GFP'     // reporter genes that do not track viral transcription

    // output
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    save_bam            = false
    save_reference      = false

    // resources: hard ceilings for any single task
    max_cpus            = 16
    max_memory          = '64.GB'
    max_time            = '24.h'

    help                = false
}

process {
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time:   params.max_time as nextflow.util.Duration
    ]
    container = 'ghcr.io/ckangas2/aligninator:0.2.0'

    withLabel: process_single     { cpus = 1;  memory = 2.GB;  time = 1.h }
    withLabel: process_low        { cpus = 2;  memory = 8.GB;  time = 2.h }
    // Human GRCh38 genomeGenerate needs ~32 GB; give it headroom.
    withLabel: process_star_index { cpus = 16; memory = 64.GB; time = 6.h }
    withLabel: process_star_align { cpus = 16; memory = 48.GB; time = 8.h }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 1
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        apptainer.enabled   = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        singularity.enabled  = false
        conda.enabled        = false
    }
    conda {
        conda.enabled       = true
        process.conda       = "${projectDir}/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
    test      { includeConfig 'conf/test.config' }
    gse163952 { includeConfig 'conf/gse163952.config' }
}

def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }
